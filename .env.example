# SLICE server. Copy to `.env` (never committed) and fill in what you need;
# a variable left empty keeps its default. Details: docs/configuration.md.

# Accounts. Both are required in production. BETTER_AUTH_SECRET: `openssl rand -hex 32`.
# BETTER_AUTH_URL: the address the browser uses; empty, http://localhost:5173 outside production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Encrypts the MCPs' API keys before they reach the database. Required everywhere,
# development included: the server refuses to start without it. 32 bytes in base64:
# `openssl rand -base64 32`. Changing it makes the saved keys unreadable.
SLICE_ENCRYPTION_KEY=

# Sign-in applications, declared step by step in docs/oauth-apps.md.
# A provider without its ID and secret is not offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Sign-in codes by email. Without RESEND_API_KEY, the code shows in the server's
# terminal and no email leaves. RESEND_FROM: a sender on a domain verified with
# Resend; empty, Resend's test sender only reaches the Resend account's address.
RESEND_API_KEY=
RESEND_FROM=

# Database. Required in production; elsewhere, empty uses the embedded database.
DATABASE_URL=
